<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voice input listens in the app itself, so the words show live while you speak. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Voice input uses the system speech recognizer; declare it for package visibility (API 30+). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".HearthApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_hearth"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hearth">

        <!--
          Kiosk: shows over the lock screen and turns the screen on, so the family never unlocks.
          The HOME filter lets the tablet use Hearth as its home app, which also starts it on boot.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize"
            tools:targetApi="27">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
