    <string name="connect_unlink_confirm">%1$s ontkoppelen?</string>
    <string name="connect_unlink_body">%1$s kan Hearth dan niet meer gebruiken. Opnieuw koppelen kan altijd met een nieuwe code.</string>
    <string name="connect_no_relay">Deze versie heeft geen koppelserver</string>
    <string name="connect_no_relay_body">ChatGPT en Claude bereiken Hearth via een gedeelde koppelserver. Deze versie van Hearth is zonder dat adres gebouwd. Vul het in onder Geavanceerd, of installeer een versie die het wel heeft.</string>
    <string name="connect_link">Koppel ChatGPT of Claude</string>
    <string name="connect_link_body">Iedereen doet dit één keer, in de eigen AI-app. Geen sleutels of wachtwoorden: je voegt dit adres toe, de app opent een Hearth-pagina en je typt de code van deze tablet.</string>
    <string name="connect_share">Delen</string>
    <string name="connect_show_code">Toon koppelcode</string>
    <string name="connect_code_valid">Typ deze code op de Hearth-pagina. Nog %1$d min geldig.</string>
    <string name="connect_code_hide">Verbergen</string>
    <string name="connect_claude">Claude</string>
    <string name="connect_claude_steps">Instellingen → Connectors → Add custom connector (aangepaste connector)|Naam: Hearth. Plak het adres hierboven. Toevoegen, dan Connect (verbinden)|Er opent een Hearth-pagina: tik hier op Toon koppelcode en typ de code daar|Zet Hearth aan in een gesprek via + → Connectors</string>
    <string name="connect_chatgpt">ChatGPT</string>
    <string name="connect_chatgpt_steps">Instellingen → Apps &amp; Connectors → Geavanceerd: zet Developer mode aan|Terug in Apps &amp; Connectors: Create (aanmaken). Naam: Hearth, plak het adres, authenticatie: OAuth|Er opent een Hearth-pagina: tik hier op Toon koppelcode en typ de code daar|Zet Hearth aan in een gesprek en zeg bv. “zet melk op de lijst”</string>
    <string name="connect_plan_note">Menunamen veranderen af en toe. ChatGPT heeft een abonnement met Developer mode nodig; Claude laat aangepaste connectors toe op de meeste abonnementen. Hearth moet open staan op de tablet.</string>
    <string name="connect_advanced">Geavanceerd</string>
    <string name="connect_advanced_body">Een eigen koppelserver? Vul het adres in. Gezinnen hebben dit normaal nooit nodig.</string>
    <string name="connect_address">Nu: %1$s</string>
    <string name="connect_manual_hint">https://hearth-relay.….workers.dev</string>
    <string name="connect_standard_relay">Terug naar de ingebouwde koppelserver</string>
