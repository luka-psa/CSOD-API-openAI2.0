    <string name="nav_connect">Instellingen</string>
    <string name="connect_subtitle">Taal, en jullie eigen ChatGPT of Claude, Google Drive en Agenda. Geen API-sleutels, geen extra kosten.</string>
    <string name="connect_on">Verbinding</string>
    <string name="connect_status_off">Uit</string>
