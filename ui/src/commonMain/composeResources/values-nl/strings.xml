    <string name="connect_show_code">Toon koppelcode</string>
    <string name="connect_code_valid">Typ deze code op de Hearth-pagina. Nog %1$d min geldig.</string>
    <string name="connect_code_hide">Verbergen</string>
    <string name="connect_plan_note">Eén knop zonder plakken kan pas als Hearth in de officiële lijst van Claude en ChatGPT staat. Claude kan het ook gratis (één eigen connector); ChatGPT vraagt een abonnement met Developer mode. Menunamen veranderen af en toe. Hearth moet open staan op de tablet.</string>
