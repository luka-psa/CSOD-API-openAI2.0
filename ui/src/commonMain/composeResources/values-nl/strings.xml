    <!-- Connect AI (MCP) -->
    <string name="nav_connect">Koppelingen</string>
    <string name="connect_subtitle">Jullie eigen ChatGPT of Claude, en jullie eigen Google Drive en Agenda. Geen API-sleutels, geen extra kosten.</string>
    <string name="connect_on">Verbinding</string>
    <string name="connect_status_off">Uit</string>
    <string name="connect_status_connecting">Verbinden…</string>
    <string name="connect_status_online">Online: jullie AI kan Hearth bereiken</string>
