    <string name="nav_connect">Connections</string>
    <string name="connect_subtitle">Your own ChatGPT or Claude, and your own Google Drive and Calendar. No API keys, no extra costs.</string>
    <string name="connect_on">Connection</string>
    <string name="connect_status_off">Off</string>
    <string name="connect_status_connecting">Connecting…</string>
    <string name="connect_status_online">Online: your AI can reach Hearth</string>
