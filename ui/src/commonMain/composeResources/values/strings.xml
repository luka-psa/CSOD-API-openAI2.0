    <!-- Connect AI (MCP) -->
    <string name="nav_connect">Connect AI</string>
    <string name="connect_subtitle">Use Hearth from your own ChatGPT or Claude, on your phone too. No API keys, no extra costs.</string>
    <string name="connect_on">Connection</string>
    <string name="connect_status_off">Off</string>
    <string name="connect_status_connecting">Connecting…</string>
    <string name="connect_status_online">Online: your AI can reach Hearth</string>
    <string name="connect_status_retrying">No connection right now, trying again by itself</string>
    <string name="connect_activity">Recently done by your AI</string>
    <string name="connect_install_title">One time: install the relay</string>
    <string name="connect_install_body">ChatGPT and Claude need an internet address to reach Hearth. A tiny relay on your own free Cloudflare account gives one. Hearth installs it for you; it stores no household data.</string>
    <string name="connect_token_steps">Make a free account at dash.cloudflare.com|Go to My Profile → API Tokens → Create Token|Choose the template “Edit Cloudflare Workers”, all accounts, then Create|Copy the token and paste it below</string>
    <string name="connect_token_hint">Cloudflare API token</string>
    <string name="connect_account_hint">Account ID (only if you have several accounts)</string>
    <string name="connect_install">Install relay</string>
    <string name="connect_manual">Already have a relay address?</string>
    <string name="connect_manual_hint">https://hearth-relay.….workers.dev</string>
    <string name="connect_link">Your Hearth link</string>
    <string name="connect_link_body">Each person adds this link once in their own AI app. Keep it within the family: whoever has it can use Hearth.</string>
    <string name="connect_share">Share link</string>
    <string name="connect_new_link">Make a new link</string>
    <string name="connect_new_link_confirm">Make a new link?</string>
    <string name="connect_new_link_body">The old link stops working. Everyone then adds the new one again.</string>
    <string name="connect_chatgpt">ChatGPT</string>
    <string name="connect_chatgpt_steps">Settings → Apps &amp; Connectors → Advanced settings: turn on Developer mode|Back in Apps &amp; Connectors: Create|Name: Hearth. Paste the link, authentication: none. Create|In a chat, switch Hearth on and say e.g. “zet melk op de lijst”</string>
    <string name="connect_claude">Claude</string>
    <string name="connect_claude_steps">Settings → Connectors → Add custom connector|Name: Hearth. Paste the link. Add|In a chat, turn Hearth on under + → Connectors</string>
    <string name="connect_plan_note">Menu names change now and then. ChatGPT needs a paid plan with Developer mode; Claude allows custom connectors on most plans. Hearth must be open on the tablet.</string>
    <string name="mcp_asks">Your AI asks</string>
