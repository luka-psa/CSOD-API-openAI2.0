    <string name="connect_apps">Linked</string>
    <string name="connect_since">since %1$s</string>
    <string name="connect_unlink_confirm">Unlink %1$s?</string>
    <string name="connect_unlink_body">%1$s can then no longer use Hearth. You can link it again any time with a new code.</string>
    <string name="connect_no_relay">This build has no relay address</string>
    <string name="connect_no_relay_body">ChatGPT and Claude reach Hearth through a shared relay. This version of Hearth was built without its address. Fill it in under Advanced, or install a build that has it.</string>
    <string name="connect_link">Link ChatGPT or Claude</string>
    <string name="connect_link_body">Each person does this once, in their own AI app. No keys or passwords: you add this address, the app opens a Hearth page, and you type the code from this tablet.</string>
    <string name="connect_share">Share</string>
    <string name="connect_show_code">Show pairing code</string>
    <string name="connect_code_valid">Type this code on the Hearth page. Valid for %1$d more min.</string>
    <string name="connect_code_hide">Hide</string>
    <string name="connect_claude">Claude</string>
    <string name="connect_claude_steps">Settings → Connectors → Add custom connector|Name: Hearth. Paste the address above. Add, then Connect|A Hearth page opens: tap Show pairing code here and type the code there|In a chat, turn Hearth on under + → Connectors</string>
    <string name="connect_chatgpt">ChatGPT</string>
    <string name="connect_chatgpt_steps">Settings → Apps &amp; Connectors → Advanced settings: turn on Developer mode|Back in Apps &amp; Connectors: Create. Name: Hearth, paste the address, authentication: OAuth|A Hearth page opens: tap Show pairing code here and type the code there|In a chat, switch Hearth on and say e.g. “zet melk op de lijst”</string>
    <string name="connect_plan_note">Menu names change now and then. ChatGPT needs a plan with Developer mode; Claude allows custom connectors on most plans. Hearth must be open on the tablet.</string>
    <string name="connect_advanced">Advanced</string>
    <string name="connect_advanced_body">Running your own relay? Enter its address. Families normally never need this.</string>
