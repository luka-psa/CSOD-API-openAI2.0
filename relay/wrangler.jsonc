// The one shared relay for every Hearth household. Deploy once: npx wrangler deploy
// (or the "Deploy relay" GitHub workflow). Then build Hearth with -Phearth.relayUrl=<its address>.
{
  "name": "hearth-relay",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "HOUSEHOLD", "class_name": "Household" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "SYNC", "class_name": "SyncSpace" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Household"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] },
    { "tag": "v3", "new_sqlite_classes": ["SyncSpace"] }
  ]
}
